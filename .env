#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
app.CSRFProtection = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = bpsk7477_meetingku
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

database.development.hostname = localhost
database.development.database = bpsk7477_meetingku
database.development.username = root
database.development.password = 
database.development.DBDriver = MySQLi
database.development.DBPrefix =
database.development.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = 'writable/session'

#--------------------------------------------------------------------
# CSRF
#--------------------------------------------------------------------

security.csrfProtection = 'cookie'
security.tokenName = 'csrf_test_name'
security.cookieName = 'csrf_cookie_name'

#--------------------------------------------------------------------
# Cookie
#--------------------------------------------------------------------
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 9


